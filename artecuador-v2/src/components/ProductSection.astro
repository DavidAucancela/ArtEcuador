---
import type { Section } from '../data/products';
import ProductCard from './ProductCard.astro';

interface Props {
  section: Section;
}
const { section } = Astro.props;
const cls = section.alt ? 'section section-alt' : 'section';
---

<section class={cls} id={section.id}>
  <div class="section-header">
    <div>
      <p class="section-label">{section.label}</p>
      <h2 class="section-title">{section.title} <em>{section.titleEm}</em></h2>
    </div>
    <span class="section-count">{section.products.length} productos</span>
  </div>
  <div class={`cat-strip cat-${section.id}`}></div>
  <div class="product-grid">
    {section.products.map((p) => <ProductCard product={p} />)}
  </div>
</section>
