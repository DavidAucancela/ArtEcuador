---
---

<section class="contact-section" id="contactar">
  <div class="contact-layout">

    <div class="contact-panel">
      <div class="contact-panel-stripe"></div>
      <div class="contact-panel-inner">

        <p class="contact-panel-eyebrow">Hablemos</p>
        <h2 class="contact-panel-title">Contáctanos,<br /><em>estamos aquí</em></h2>
        <p class="contact-panel-sub">Artesanías ecuatorianas al mundo. Escríbenos para consultas, pedidos personalizados o para conocer más sobre nuestros artesanos.</p>

        <div class="contact-items">
          <div class="contact-item">
            <div class="contact-item-icon cii-email">
              <svg viewBox="0 0 20 20" fill="none">
                <rect x="2" y="4" width="16" height="12" rx="2.5" stroke="#D7262E" stroke-width="1.6"/>
                <path d="M2 7l7.293 5.121a1.2 1.2 0 0 0 1.414 0L18 7" stroke="#D7262E" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </div>
            <div>
              <p class="contact-item-label">Email</p>
              <p class="contact-item-value">quitoarte@gmail.com</p>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-item-icon cii-phone">
              <svg viewBox="0 0 20 20" fill="none">
                <path d="M6.5 2H4a2 2 0 0 0-2 2c0 8.284 6.716 15 15 15a2 2 0 0 0 2-2v-2.5a1 1 0 0 0-.684-.949l-3-1a1 1 0 0 0-1.052.26l-1.2 1.3A11.05 11.05 0 0 1 7.889 8.936l1.3-1.2a1 1 0 0 0 .26-1.052l-1-3A1 1 0 0 0 7.5 3H6.5z" stroke="#4CAF50" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div>
              <p class="contact-item-label">Teléfono</p>
              <p class="contact-item-value">+593 99 900 6925</p>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-item-icon cii-wa">
              <svg viewBox="0 0 20 20" fill="none">
                <path d="M10 2a8 8 0 0 1 6.928 12.01L18 18l-4.109-1.054A8 8 0 1 1 10 2z" stroke="#25D366" stroke-width="1.6" stroke-linejoin="round"/>
                <path d="M7 8.5c0-.5.5-2 2-1 .5.3.8 1 1 1.5.1.3-.1.7-.4.9l-.4.3c.3.6.8 1.1 1.4 1.5l.4-.4c.2-.2.6-.3.9-.1.5.2 1.1.6 1.4 1 .8 1.2-.5 2-1 2-2.2.1-6-3.7-5.3-5.7z" fill="#25D366" opacity=".85"/>
              </svg>
            </div>
            <div>
              <p class="contact-item-label">WhatsApp</p>
              <p class="contact-item-value">+593 99 900 6925</p>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-item-icon cii-map">
              <svg viewBox="0 0 20 20" fill="none">
                <path d="M10 2a5.5 5.5 0 0 1 5.5 5.5c0 4.5-5.5 10.5-5.5 10.5S4.5 12 4.5 7.5A5.5 5.5 0 0 1 10 2z" stroke="#2D9CDB" stroke-width="1.6" stroke-linejoin="round"/>
                <circle cx="10" cy="7.5" r="2" stroke="#2D9CDB" stroke-width="1.5"/>
              </svg>
            </div>
            <div>
              <p class="contact-item-label">Dirección</p>
              <p class="contact-item-value">
                Reina Victoria y Jorge Washington<br />
                Mercado Artesanal "La Mariscal" Local 103<br />
                <span style="color:rgba(255,255,255,0.28);font-size:0.74rem;">Lun–Dom · 8:00–19:00</span>
              </p>
            </div>
          </div>
        </div>

        <p class="contact-social-label">Síguenos</p>
        <div class="contact-social-row">
          <a href="https://www.instagram.com/artecuador_hecho_a_mano/" target="_blank" rel="noopener" class="social-btn social-btn-ig" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none">
              <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="17.6" cy="6.4" r="1.1" fill="currentColor"/>
            </svg>
          </a>
          <a href="https://www.facebook.com/Miguelmaguan/" target="_blank" rel="noopener" class="social-btn social-btn-fb" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M17 2h-3.5A4.5 4.5 0 0 0 9 6.5V9.5H6v4h3V22h4V13.5h3l.5-4H13V6.5a1 1 0 0 1 1-1H17V2z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="contact-form-wrap">
      <div class="form-heading-bar"></div>
      <h3 class="form-title">Contáctanos<br />por WhatsApp</h3>
      <p class="form-subtitle">Completa el formulario y abriremos una conversación de WhatsApp con tu mensaje listo para enviar.</p>

      <form id="contactForm">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="f-name">Nombre</label>
            <input class="form-input" type="text" id="f-name" placeholder="Tu nombre completo" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="f-email">Email</label>
            <input class="form-input" type="email" id="f-email" placeholder="tu@email.com" required />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="f-phone">Teléfono (opcional)</label>
            <input class="form-input" type="tel" id="f-phone" placeholder="+593 ..." />
          </div>
          <div class="form-group">
            <label class="form-label" for="f-country">País</label>
            <select class="form-select" id="f-country">
              <option value="">Selecciona tu país</option>
              <option>Ecuador</option>
              <option>Estados Unidos</option>
              <option>España</option>
              <option>Colombia</option>
              <option>México</option>
              <option>Otro</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="f-tipo">Tipo de consulta</label>
          <select class="form-select" id="f-tipo">
            <option value="">¿En qué te podemos ayudar?</option>
            <option>Consulta sobre un producto</option>
            <option>Pedido personalizado / mayoreo</option>
            <option>Envíos internacionales</option>
            <option>Quiero ser artesano asociado</option>
            <option>Prensa y medios</option>
            <option>Otro</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="f-msg">Mensaje</label>
          <textarea class="form-textarea" id="f-msg" placeholder="Cuéntanos cómo te podemos ayudar..." required></textarea>
        </div>

        <div id="form-success" style="display:none;background:#e8f5e9;border:1px solid #4CAF50;border-radius:6px;padding:14px 18px;color:#2e7d32;font-size:0.875rem;font-weight:600;text-align:center;">
          ¡Mensaje enviado! Te contactaremos pronto por WhatsApp.
        </div>

        <button type="submit" class="form-submit">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 2a10 10 0 0 1 8.66 15.01L22 22l-5.13-1.32A10 10 0 1 1 12 2z" fill="white" opacity=".25" stroke="white" stroke-width="1.3"/>
            <path d="M8.5 10.5c0-.6.6-2.4 2.5-1.2.6.36 1 1.2 1.25 1.8.12.36-.12.84-.5 1.08l-.5.36c.38.72 1 1.32 1.75 1.8l.5-.48c.25-.24.75-.36 1.12-.12.62.24 1.38.72 1.75 1.2 1 1.44-.62 2.4-1.25 2.4-2.75.12-7.5-4.44-6.62-6.84z" fill="white"/>
          </svg>
          Enviar por WhatsApp
        </button>
      </form>
    </div>

  </div>
</section>
