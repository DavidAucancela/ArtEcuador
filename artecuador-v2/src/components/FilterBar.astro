---
import { getSections } from '../data/products';
const sections = await getSections();
---

<div class="filter-bar" id="filterBar">
  <div class="filter-bar-inner">
    <!-- Búsqueda -->
    <div class="filter-search-wrap">
      <svg class="filter-search-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <circle cx="9" cy="9" r="5.5" stroke="currentColor" stroke-width="1.6"/>
        <path d="M13.5 13.5L17 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
      <input
        class="filter-search"
        id="filterSearch"
        type="text"
        placeholder="Buscar artesanía..."
        aria-label="Buscar productos"
        autocomplete="off"
      />
      <button class="filter-search-clear" id="filterClear" aria-label="Limpiar búsqueda" style="display:none">
        <svg viewBox="0 0 14 14" fill="none"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>

    <!-- Filtros de categoría -->
    <div class="filter-cats" role="group" aria-label="Filtrar por categoría">
      <button class="filter-cat active" data-cat="all">Todos</button>
      {sections.map((s) => (
        <button class="filter-cat" data-cat={s.id}>
          {s.title} {s.titleEm}
        </button>
      ))}
    </div>

    <!-- Contador de resultados -->
    <span class="filter-count" id="filterCount" aria-live="polite"></span>
  </div>
</div>

<div class="filter-no-results" id="filterNoResults" style="display:none">
  <p>No se encontraron productos para "<strong id="filterNoResultsTerm"></strong>"</p>
  <button class="filter-reset-btn" id="filterReset">Ver todos los productos</button>
</div>

<style>
  .filter-bar {
    position: sticky; top: 72px; z-index: 90;
    background: rgba(250,250,248,0.97);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(0,0,0,0.06);
    padding: 0 48px;
  }
  .filter-bar-inner {
    max-width: 1400px; margin: 0 auto;
    display: flex; align-items: center; gap: 20px;
    height: 56px; overflow-x: auto;
    scrollbar-width: none;
  }
  .filter-bar-inner::-webkit-scrollbar { display: none; }

  /* Search */
  .filter-search-wrap {
    position: relative; flex-shrink: 0;
    display: flex; align-items: center;
  }
  .filter-search-icon {
    position: absolute; left: 10px;
    width: 15px; height: 15px;
    color: var(--gray-m); pointer-events: none;
  }
  .filter-search {
    width: 200px; padding: 7px 32px 7px 30px;
    border: 1.5px solid #E8E4DE; border-radius: 20px;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.78rem; background: #fff;
    transition: border-color 0.2s, width 0.3s;
    outline: none;
  }
  .filter-search:focus { border-color: var(--red); width: 260px; }
  .filter-search-clear {
    position: absolute; right: 8px;
    background: none; border: none; cursor: pointer;
    color: var(--gray-m); padding: 2px;
    display: flex; align-items: center;
  }
  .filter-search-clear svg { width: 10px; height: 10px; }
  .filter-search-clear:hover { color: var(--red); }

  /* Category buttons */
  .filter-cats {
    display: flex; gap: 6px; flex-shrink: 0;
  }
  .filter-cat {
    padding: 5px 14px; border-radius: 20px;
    border: 1.5px solid #E8E4DE; background: #fff;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em;
    cursor: pointer; white-space: nowrap;
    color: var(--gray-d); transition: all 0.18s;
  }
  .filter-cat:hover { border-color: var(--red); color: var(--red); }
  .filter-cat.active {
    background: var(--red); border-color: var(--red);
    color: #fff;
  }

  /* Count */
  .filter-count {
    margin-left: auto; flex-shrink: 0;
    font-size: 0.7rem; font-weight: 500; color: var(--gray-m);
    white-space: nowrap;
  }

  /* No results */
  .filter-no-results {
    text-align: center; padding: 80px 24px;
    font-size: 1rem; color: var(--gray-d);
  }
  .filter-reset-btn {
    margin-top: 16px;
    padding: 10px 24px; border-radius: 6px;
    background: var(--red); color: #fff; border: none;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.8rem; font-weight: 600; cursor: pointer;
  }

  @media (max-width: 900px) {
    .filter-bar { padding: 0 16px; }
    .filter-search { width: 160px; }
    .filter-search:focus { width: 190px; }
  }
  @media (max-width: 560px) {
    .filter-bar-inner { height: auto; padding: 10px 0; flex-wrap: wrap; gap: 10px; }
    .filter-search-wrap { width: 100%; }
    .filter-search,
    .filter-search:focus { width: 100%; }
    /* Los chips de categoría tienen su propio scroll horizontal para que
       ninguna categoría quede fuera de pantalla cuando la barra se envuelve. */
    .filter-cats {
      width: 100%;
      overflow-x: auto;
      -ms-overflow-style: none;
      scrollbar-width: none;
      padding-bottom: 2px;
    }
    .filter-cats::-webkit-scrollbar { display: none; }
    .filter-count { margin-left: 0; }
  }
</style>

<script>
  (function () {
    const searchInput  = document.getElementById('filterSearch') as HTMLInputElement;
    const clearBtn     = document.getElementById('filterClear') as HTMLButtonElement;
    const countEl      = document.getElementById('filterCount') as HTMLElement;
    const noResults    = document.getElementById('filterNoResults') as HTMLElement;
    const noResultsTerm= document.getElementById('filterNoResultsTerm') as HTMLElement;
    const resetBtn     = document.getElementById('filterReset') as HTMLButtonElement;
    const catBtns      = document.querySelectorAll<HTMLButtonElement>('.filter-cat');

    let activeCat = 'all';
    let query     = '';

    // Paginación: N productos por página, por sección. Se reinicia a la página 1
    // cuando cambia la búsqueda o la categoría.
    const PAGE_SIZE = 8;
    const pageBySection: Record<string, number> = {};
    function resetPages() { for (const k in pageBySection) delete pageBySection[k]; }

    function applyFilters() {
      const grids = document.querySelectorAll<HTMLElement>('.product-grid');
      const total = document.querySelectorAll('.product-card').length;
      let visible = 0;

      grids.forEach((grid) => {
        const sec = grid.closest('section') as HTMLElement | null;
        if (!sec) return;
        const sectionId = sec.id;
        const cards     = [...grid.querySelectorAll<HTMLElement>('.product-card')];
        const matchCat  = activeCat === 'all' || sectionId === activeCat;

        if (!matchCat) {
          cards.forEach((c) => (c.style.display = 'none'));
          sec.style.display = 'none';
          renderPagination(sec, 0, 1);
          return;
        }

        // Productos que pasan el filtro de texto
        const eligible = cards.filter((card) => {
          const name     = card.dataset.name ?? '';
          const category = card.dataset.category ?? '';
          return !query || name.includes(query) || category.includes(query);
        });
        const eligibleSet = new Set(eligible);

        // Página actual acotada al rango válido
        const pageCount = Math.max(1, Math.ceil(eligible.length / PAGE_SIZE));
        let page = pageBySection[sectionId] || 1;
        if (page > pageCount) page = pageCount;
        pageBySection[sectionId] = page;
        const start = (page - 1) * PAGE_SIZE;
        const end   = start + PAGE_SIZE;

        // Solo se muestran los productos elegibles de la página actual
        let idx = 0;
        cards.forEach((card) => {
          if (!eligibleSet.has(card)) { card.style.display = 'none'; return; }
          card.style.display = (idx >= start && idx < end) ? '' : 'none';
          idx++;
        });

        sec.style.display = eligible.length ? '' : 'none';
        visible += eligible.length;
        renderPagination(sec, eligible.length, page);
      });

      countEl.textContent = query || activeCat !== 'all'
        ? `${visible} de ${total} productos`
        : '';

      noResults.style.display = visible === 0 ? '' : 'none';
      noResultsTerm.textContent = query;
    }

    function renderPagination(sec: HTMLElement, count: number, page: number) {
      const nav = sec.querySelector<HTMLElement>('.pagination');
      if (!nav) return;
      const pageCount = Math.ceil(count / PAGE_SIZE);
      if (pageCount <= 1) { nav.hidden = true; nav.innerHTML = ''; return; }
      nav.hidden = false;
      let html = `<button class="pg-btn pg-arrow" data-go="${page - 1}"${page <= 1 ? ' disabled' : ''} aria-label="Página anterior">‹</button>`;
      for (let i = 1; i <= pageCount; i++) {
        html += `<button class="pg-btn pg-num${i === page ? ' active' : ''}" data-go="${i}"${i === page ? ' aria-current="page"' : ''} aria-label="Página ${i}">${i}</button>`;
      }
      html += `<button class="pg-btn pg-arrow" data-go="${page + 1}"${page >= pageCount ? ' disabled' : ''} aria-label="Página siguiente">›</button>`;
      nav.innerHTML = html;
    }

    // Search input
    searchInput.addEventListener('input', () => {
      query = searchInput.value.toLowerCase().trim();
      clearBtn.style.display = query ? '' : 'none';
      resetPages();
      applyFilters();
    });

    clearBtn.addEventListener('click', () => {
      searchInput.value = '';
      query = '';
      clearBtn.style.display = 'none';
      resetPages();
      applyFilters();
    });

    // Category buttons
    function getStickyOffset() {
      const nav = document.querySelector('nav');
      const filterBar = document.getElementById('filterBar');
      const navH = nav?.offsetHeight ?? 72;
      const filterH = filterBar?.offsetHeight ?? 56;
      return navH + filterH + 16;
    }

    catBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCat = btn.dataset.cat ?? 'all';
        catBtns.forEach((b) => b.classList.toggle('active', b === btn));
        resetPages();

        if (activeCat === 'all') {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          const target = document.getElementById(activeCat);
          if (target) {
            const y = target.getBoundingClientRect().top + window.scrollY - getStickyOffset();
            window.scrollTo({ top: y, behavior: 'smooth' });
          }
        }
        applyFilters();
      });
    });

    // Reset
    resetBtn.addEventListener('click', () => {
      searchInput.value = '';
      query = '';
      activeCat = 'all';
      clearBtn.style.display = 'none';
      catBtns.forEach((b) => b.classList.toggle('active', b.dataset.cat === 'all'));
      resetPages();
      window.scrollTo({ top: 0, behavior: 'smooth' });
      applyFilters();
    });

    // Clics de paginación (botones inyectados dinámicamente)
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.pg-btn') as HTMLButtonElement | null;
      if (!btn || btn.disabled) return;
      const nav = btn.closest('.pagination') as HTMLElement | null;
      if (!nav) return;
      const sectionId = nav.dataset.section ?? '';
      pageBySection[sectionId] = parseInt(btn.dataset.go ?? '1', 10);
      applyFilters();
      const target = document.getElementById(sectionId);
      if (target) {
        const y = target.getBoundingClientRect().top + window.scrollY - getStickyOffset();
        window.scrollTo({ top: y, behavior: 'smooth' });
      }
    });

    // Estado inicial: aplica la paginación al cargar (página 1 por sección)
    applyFilters();

    function updateMobileNav(id: string | null) {
      document.querySelectorAll<HTMLElement>('.mobile-nav a[href^="#"]').forEach((a) => {
        a.classList.toggle('active', id !== null && a.getAttribute('href') === `#${id}`);
      });
    }

    // Highlight active category on scroll
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && activeCat === 'all') {
            const id = (entry.target as HTMLElement).id;
            // Solo resaltar cuando la sección visible es una colección con chip
            // propio; las secciones sin chip (portada, contacto…) no deben
            // apagar el resaltado actual.
            const isCat = [...catBtns].some((b) => b.dataset.cat === id);
            if (isCat) {
              catBtns.forEach((b) => b.classList.toggle('active', b.dataset.cat === id));
              updateMobileNav(id);
            }
          }
        });
      },
      { rootMargin: '-30% 0px -60% 0px' }
    );

    document.querySelectorAll('section[id]').forEach((s) => observer.observe(s));

    // Re-highlight "Todos" when scrolled to top / no section intersecting
    const topObserver = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && activeCat === 'all') {
          catBtns.forEach((b) => b.classList.toggle('active', b.dataset.cat === 'all'));
          updateMobileNav(null);
        }
      },
      { threshold: 0.1 }
    );
    const cover = document.getElementById('portada');
    if (cover) topObserver.observe(cover);
  })();
</script>
