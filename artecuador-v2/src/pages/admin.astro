---
// Panel de administración — página servidor, sin layout del sitio público
export const prerender = false;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ArtEcuador — Panel Admin</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --red:      #D7262E;
      --red-dark: #b01e25;
      --navy:     #1A1A2E;
      --navy-l:   #24243e;
      --bg:       #F4F5F7;
      --white:    #FFFFFF;
      --border:   #E2E4E8;
      --text:     #1A1A2E;
      --muted:    #6B7280;
      --green:    #22c55e;
      --orange:   #f59e0b;
      --radius:   8px;
      --shadow:   0 1px 4px rgba(0,0,0,0.08);
      --shadow-lg:0 8px 32px rgba(0,0,0,0.14);
    }

    html, body { height: 100%; font-family: 'Inter', sans-serif; font-size: 14px; color: var(--text); background: var(--bg); }

    /* ── LAYOUT ── */
    .app { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }

    header {
      display: flex; align-items: center; gap: 16px;
      background: var(--white); border-bottom: 1px solid var(--border);
      padding: 0 24px; height: 56px; flex-shrink: 0; z-index: 10;
    }
    header .logo { font-size: 18px; font-weight: 700; color: var(--red); letter-spacing: -0.3px; }
    header .logo span { color: var(--navy); }
    header .spacer { flex: 1; }
    .save-status { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--muted); }
    .save-status .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green); flex-shrink: 0; }
    .save-status .dot.dirty { background: var(--orange); }

    .btn-back {
      background: none; border: 1px solid var(--border); border-radius: var(--radius);
      padding: 6px 12px; font-size: 13px; font-weight: 500; cursor: pointer; color: var(--muted);
      text-decoration: none; display: flex; align-items: center; gap: 6px;
      transition: background 0.15s, color 0.15s;
    }
    .btn-back:hover { background: var(--bg); color: var(--text); }

    .body { display: flex; flex: 1; overflow: hidden; }

    /* ── SIDEBAR ── */
    aside {
      width: 240px; background: var(--navy); color: #fff;
      display: flex; flex-direction: column; flex-shrink: 0; overflow-y: auto;
    }
    .sidebar-top { padding: 20px 16px 0; }
    .stats-box {
      background: rgba(255,255,255,0.07); border-radius: var(--radius);
      padding: 12px; margin-bottom: 20px;
    }
    .stats-box h4 { font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; color: rgba(255,255,255,0.5); margin-bottom: 10px; }
    .stats-row { display: flex; gap: 4px; }
    .stat-pill {
      flex: 1; background: rgba(255,255,255,0.1); border-radius: 6px;
      padding: 6px 4px; text-align: center;
    }
    .stat-pill .n { display: block; font-size: 18px; font-weight: 700; line-height: 1; }
    .stat-pill .l { display: block; font-size: 10px; color: rgba(255,255,255,0.55); margin-top: 2px; }
    .stat-pill.active .n { color: var(--green); }
    .stat-pill.inactive .n { color: #f87171; }

    .section-label-header {
      font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px;
      color: rgba(255,255,255,0.4); padding: 0 16px 8px;
    }
    .section-list { list-style: none; padding: 0 8px; }
    .section-list li {
      display: flex; align-items: center; gap: 8px; padding: 9px 8px;
      border-radius: var(--radius); cursor: pointer; transition: background 0.15s;
      user-select: none;
    }
    .section-list li:hover { background: rgba(255,255,255,0.08); }
    .section-list li.active { background: var(--red); }
    .section-list li .sec-name { flex: 1; font-weight: 500; font-size: 13px; }
    .section-list li .count-badge {
      background: rgba(255,255,255,0.18); color: #fff; font-size: 11px;
      font-weight: 600; padding: 2px 7px; border-radius: 20px; min-width: 24px; text-align: center;
    }
    .section-list li.active .count-badge { background: rgba(255,255,255,0.3); }
    .section-list li .edit-sec-btn {
      background: none; border: none; color: rgba(255,255,255,0.45); cursor: pointer;
      padding: 2px 4px; border-radius: 4px; font-size: 14px; line-height: 1;
      transition: color 0.15s;
    }
    .section-list li:hover .edit-sec-btn,
    .section-list li.active .edit-sec-btn { color: rgba(255,255,255,0.85); }

    .sidebar-bottom { padding: 12px 8px; margin-top: auto; }
    .btn-add-section {
      display: flex; align-items: center; justify-content: center; gap: 6px;
      width: 100%; padding: 9px 12px; border-radius: var(--radius); border: none;
      background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.75);
      font-size: 13px; font-weight: 500; cursor: pointer; transition: background 0.15s;
    }
    .btn-add-section:hover { background: rgba(255,255,255,0.14); color: #fff; }

    /* ── MAIN ── */
    main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

    .main-header {
      background: var(--white); border-bottom: 1px solid var(--border);
      padding: 16px 24px; display: flex; align-items: center; gap: 12px; flex-shrink: 0;
    }
    .main-header h2 { font-size: 18px; font-weight: 700; }
    .main-header h2 em { color: var(--muted); font-style: normal; font-weight: 400; }
    .main-header .section-label-badge {
      font-size: 11px; color: var(--muted); background: var(--bg);
      padding: 3px 8px; border-radius: 4px; border: 1px solid var(--border);
    }
    .main-header .spacer { flex: 1; }
    .btn-primary {
      background: var(--red); color: #fff; border: none; border-radius: var(--radius);
      padding: 8px 16px; font-size: 13px; font-weight: 600; cursor: pointer;
      display: flex; align-items: center; gap: 6px; transition: background 0.15s;
    }
    .btn-primary:hover { background: var(--red-dark); }
    .btn-primary:disabled { background: #ccc; cursor: not-allowed; }

    /* ── PRODUCT GRID ── */
    .product-list {
      flex: 1; overflow-y: auto; padding: 20px 24px;
    }
    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
      gap: 16px;
      align-content: start;
    }

    /* ── PRODUCT CARD (admin) ── */
    .product-card-admin {
      background: var(--white); border: 1.5px solid var(--border);
      border-radius: 10px; overflow: hidden; cursor: default;
      display: flex; flex-direction: column;
      transition: box-shadow 0.15s, opacity 0.15s, border-color 0.15s;
    }
    .product-card-admin:hover { box-shadow: var(--shadow-lg); border-color: #c8cad0; }
    .product-card-admin.dragging { opacity: 0.35; }
    .product-card-admin.drag-over { border: 2px dashed var(--red); background: #fff5f5; }
    .product-card-admin.inactive-card { opacity: 0.55; }

    /* card top bar: handle + badge + toggle + actions */
    .card-topbar {
      display: flex; align-items: center; gap: 6px;
      padding: 7px 10px; border-bottom: 1px solid var(--border);
      background: var(--bg); flex-shrink: 0;
    }
    .drag-handle {
      color: #bbb; font-size: 15px; cursor: grab; user-select: none; line-height: 1;
      flex-shrink: 0;
    }
    .drag-handle:active { cursor: grabbing; }
    .card-topbar-spacer { flex: 1; }

    /* badge chip */
    .badge-chip {
      font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 20px;
      text-transform: uppercase; letter-spacing: 0.04em;
    }
    .badge-chip.feat  { background: #EFF6FF; color: #1D4ED8; }
    .badge-chip.new   { background: #F0FDF4; color: #15803D; }
    .badge-chip.limit { background: #F5F3FF; color: #6D28D9; }

    /* toggle switch */
    .toggle { position: relative; width: 34px; height: 19px; flex-shrink: 0; }
    .toggle input { opacity: 0; width: 0; height: 0; position: absolute; }
    .toggle-slider {
      position: absolute; inset: 0; border-radius: 20px; background: #CBD5E0;
      cursor: pointer; transition: background 0.2s;
    }
    .toggle-slider::before {
      content: ''; position: absolute; width: 13px; height: 13px; border-radius: 50%;
      background: #fff; top: 3px; left: 3px; transition: transform 0.2s;
    }
    .toggle input:checked + .toggle-slider { background: var(--green); }
    .toggle input:checked + .toggle-slider::before { transform: translateX(15px); }

    .icon-btn {
      background: none; border: none; cursor: pointer; padding: 5px;
      border-radius: 6px; font-size: 14px; color: var(--muted);
      transition: color 0.15s, background 0.15s; line-height: 1;
    }
    .icon-btn:hover { background: var(--border); color: var(--text); }
    .icon-btn.delete:hover { color: #ef4444; background: #fef2f2; }

    /* card image — consistent 4:3 */
    .card-img-wrap {
      aspect-ratio: 4 / 3; overflow: hidden; background: #f0ede8;
      cursor: pointer; position: relative; flex-shrink: 0;
    }
    .card-img-wrap img {
      width: 100%; height: 100%; object-fit: cover; display: block;
      transition: transform 0.3s ease;
    }
    .card-img-wrap:hover img { transform: scale(1.05); }
    .card-img-placeholder {
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      font-size: 36px; color: #c0b8ae; cursor: pointer;
    }
    .card-img-edit-hint {
      position: absolute; inset: 0; background: rgba(0,0,0,0.35);
      display: flex; align-items: center; justify-content: center;
      opacity: 0; transition: opacity 0.2s;
      color: #fff; font-size: 12px; font-weight: 600; letter-spacing: 0.05em;
    }
    .card-img-wrap:hover .card-img-edit-hint { opacity: 1; }

    /* card body */
    .card-body {
      padding: 10px 12px 12px; flex: 1; display: flex; flex-direction: column; gap: 3px;
    }
    .card-name {
      font-weight: 700; font-size: 13px; line-height: 1.3; color: var(--text);
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .card-cat { font-size: 11px; color: var(--muted); }
    .card-price { font-weight: 700; color: var(--red); font-size: 15px; margin-top: 4px; }
    .card-no-price { font-size: 11px; color: #ccc; margin-top: 4px; }

    /* delete confirm card overlay */
    .confirm-card {
      border: 2px solid #fca5a5; border-radius: 10px; background: #fef2f2;
      overflow: hidden; padding: 14px;
      display: flex; flex-direction: column; gap: 10px;
    }
    .confirm-card .confirm-text { font-size: 12px; color: #7f1d1d; }
    .confirm-card .confirm-text strong { font-weight: 700; }
    .confirm-card .confirm-actions { display: flex; gap: 6px; }
    .btn-confirm-del {
      background: #ef4444; color: #fff; border: none; border-radius: 6px;
      padding: 6px 12px; font-size: 12px; font-weight: 600; cursor: pointer; flex: 1;
    }
    .btn-cancel-del {
      background: none; color: var(--muted); border: 1px solid var(--border);
      border-radius: 6px; padding: 6px 12px; font-size: 12px; cursor: pointer;
    }

    /* Empty state */
    .empty-state {
      text-align: center; padding: 60px 20px; color: var(--muted);
      grid-column: 1 / -1;
    }
    .empty-state .icon { font-size: 40px; margin-bottom: 12px; }
    .empty-state p { font-size: 15px; }

    /* ── MODALS ── */
    .modal-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,0.45);
      display: flex; align-items: center; justify-content: center;
      z-index: 1000; padding: 20px;
      animation: fadeIn 0.15s ease;
    }
    .modal-overlay.hidden { display: none; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    .modal-box {
      background: var(--white); border-radius: 12px; width: 100%; max-width: 620px;
      max-height: 90vh; overflow-y: auto; box-shadow: var(--shadow-lg);
      animation: slideUp 0.18s ease;
    }
    @keyframes slideUp { from { transform: translateY(16px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

    .modal-box.small { max-width: 440px; }

    .modal-header {
      display: flex; align-items: center; padding: 20px 24px 0;
      border-bottom: 1px solid var(--border); padding-bottom: 16px; margin-bottom: 20px;
    }
    .modal-header h3 { font-size: 17px; font-weight: 700; flex: 1; }
    .modal-close {
      background: none; border: none; cursor: pointer; font-size: 20px;
      color: var(--muted); padding: 2px 6px; border-radius: 4px; line-height: 1;
    }
    .modal-close:hover { color: var(--text); background: var(--bg); }

    .modal-body { padding: 0 24px 20px; }

    .img-preview-wrap {
      display: flex; justify-content: center; margin-bottom: 20px;
    }
    .img-preview {
      width: 120px; height: 120px; border-radius: 10px; object-fit: cover;
      border: 2px solid var(--border); background: var(--bg);
    }
    .img-preview-placeholder {
      width: 120px; height: 120px; border-radius: 10px;
      border: 2px dashed var(--border); background: var(--bg);
      display: flex; align-items: center; justify-content: center; font-size: 36px; color: var(--muted);
    }

    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .form-full { grid-column: 1 / -1; }

    .form-group { display: flex; flex-direction: column; gap: 5px; }
    .form-group label { font-size: 12px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; }
    .form-group input,
    .form-group textarea,
    .form-group select {
      border: 1px solid var(--border); border-radius: var(--radius);
      padding: 8px 10px; font-size: 13px; font-family: inherit; color: var(--text);
      background: var(--white); transition: border-color 0.15s;
      outline: none;
    }
    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus { border-color: var(--red); box-shadow: 0 0 0 2px rgba(215,38,46,0.1); }
    .form-group textarea { resize: vertical; min-height: 72px; }
    .form-group.has-error input,
    .form-group.has-error textarea { border-color: #ef4444; }
    .error-msg { font-size: 11px; color: #ef4444; margin-top: 2px; }

    .price-wrap { position: relative; }
    .price-wrap .prefix {
      position: absolute; left: 10px; top: 50%; transform: translateY(-50%);
      color: var(--muted); font-weight: 600; font-size: 13px; pointer-events: none;
    }
    .price-wrap input { padding-left: 22px; }

    .toggle-row { display: flex; align-items: center; gap: 10px; padding: 4px 0; }
    .toggle-row label.toggle-label { font-size: 13px; font-weight: 500; cursor: pointer; }

    .modal-footer {
      display: flex; gap: 10px; justify-content: flex-end;
      padding: 16px 24px; border-top: 1px solid var(--border); margin-top: 4px;
    }
    .btn-secondary {
      background: none; border: 1px solid var(--border); border-radius: var(--radius);
      padding: 8px 16px; font-size: 13px; font-weight: 500; cursor: pointer; color: var(--text);
      transition: background 0.15s;
    }
    .btn-secondary:hover { background: var(--bg); }

    /* ── TOAST ── */
    .toast {
      position: fixed; bottom: 24px; right: 24px; z-index: 2000;
      background: #1A1A2E; color: #fff; padding: 12px 20px;
      border-radius: var(--radius); font-size: 13px; font-weight: 500;
      display: flex; align-items: center; gap: 8px;
      box-shadow: var(--shadow-lg); animation: toastIn 0.2s ease;
      pointer-events: none;
    }
    .toast.hidden { display: none; }
    @keyframes toastIn { from { transform: translateY(8px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

    /* ── SAVE BUTTON in header ── */
    #btnSave {
      background: var(--red); color: #fff; border: none; border-radius: var(--radius);
      padding: 7px 18px; font-size: 13px; font-weight: 600; cursor: pointer;
      transition: background 0.15s; display: flex; align-items: center; gap: 6px;
    }
    #btnSave:hover:not(:disabled) { background: var(--red-dark); }
    #btnSave:disabled { background: #ccc; cursor: not-allowed; }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

    /* ── SECTION DRAG ── */
    .sec-drag-handle {
      color: rgba(255,255,255,0.25); font-size: 13px; cursor: grab;
      padding: 0 2px; flex-shrink: 0; user-select: none; line-height: 1;
    }
    .section-list li:hover .sec-drag-handle,
    .section-list li.active .sec-drag-handle { color: rgba(255,255,255,0.6); }
    .section-list li.sec-drag-over { border: 2px dashed rgba(215,38,46,0.6); background: rgba(215,38,46,0.08); }

    /* ── BTN DANGER ── */
    .btn-danger {
      background: none; border: 1px solid #ef4444; color: #ef4444;
      border-radius: var(--radius); padding: 8px 16px; font-size: 13px;
      font-weight: 500; cursor: pointer; transition: background 0.15s;
    }
    .btn-danger:hover { background: #fef2f2; }

    /* ── DELETE SECTION CONFIRM (inline in modal) ── */
    .del-sec-confirm {
      background: #fef2f2; border: 1px solid #fca5a5; border-radius: var(--radius);
      padding: 14px 16px; margin-bottom: 16px;
    }
    .del-sec-confirm p { font-size: 13px; color: #7f1d1d; margin-bottom: 10px; }
    .del-sec-confirm .actions { display: flex; gap: 8px; }

    /* ── IMG PICKER TRIGGER ── */
    .img-picker-trigger {
      display: flex; align-items: center; gap: 10px;
      border: 1px solid var(--border); border-radius: var(--radius);
      padding: 7px 10px; cursor: pointer; background: var(--white);
      transition: border-color 0.15s; font-size: 13px; color: var(--muted);
      user-select: none;
    }
    .img-picker-trigger:hover { border-color: var(--red); }
    .img-picker-thumb {
      width: 32px; height: 32px; border-radius: 4px; object-fit: cover;
      background: var(--bg); border: 1px solid var(--border); flex-shrink: 0;
      display: flex; align-items: center; justify-content: center; font-size: 16px;
    }
    .img-picker-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 3px; }

    /* ── IMAGE GALLERY MODAL ── */
    .img-gallery-modal {
      position: fixed; inset: 0; background: rgba(0,0,0,0.6);
      z-index: 1100; display: flex; align-items: center; justify-content: center;
      padding: 20px; animation: fadeIn 0.15s ease;
    }
    .img-gallery-modal.hidden { display: none; }
    .img-gallery-box {
      background: var(--white); border-radius: 12px; width: 100%; max-width: 700px;
      height: 88vh; display: flex; flex-direction: column; box-shadow: var(--shadow-lg);
      overflow: hidden;
    }
    .img-gallery-header {
      padding: 16px 20px; border-bottom: 1px solid var(--border);
      display: flex; align-items: center; gap: 10px; flex-shrink: 0;
    }
    .img-gallery-header h4 { font-size: 16px; font-weight: 700; flex: 1; }
    .img-gallery-search {
      border: 1px solid var(--border); border-radius: 6px;
      padding: 7px 10px; font-size: 13px; outline: none; width: 200px;
      font-family: inherit;
    }
    .img-gallery-search:focus { border-color: var(--red); }
    .img-gallery-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
      gap: 8px; padding: 16px; overflow-y: auto; flex: 1; min-height: 0;
    }
    .img-gallery-item {
      border: 2px solid transparent; border-radius: 8px; cursor: pointer;
      overflow: hidden; aspect-ratio: 1; position: relative;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .img-gallery-item:hover { border-color: var(--red); box-shadow: 0 0 0 2px rgba(215,38,46,0.15); }
    .img-gallery-item.selected { border-color: var(--red); box-shadow: 0 0 0 3px rgba(215,38,46,0.25); }
    .img-gallery-item img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .img-gallery-item .img-label {
      position: absolute; bottom: 0; left: 0; right: 0;
      background: rgba(0,0,0,0.65); color: #fff; font-size: 9px;
      padding: 3px 4px; text-align: center; opacity: 0; transition: opacity 0.15s;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .img-gallery-item:hover .img-label { opacity: 1; }
    .img-gallery-empty { padding: 40px; text-align: center; color: var(--muted); font-size: 13px; }
    .img-gallery-footer {
      padding: 12px 20px; border-top: 1px solid var(--border);
      display: flex; gap: 8px; align-items: center; flex-shrink: 0;
    }

    /* Upload spinner */
    .upload-spinner {
      display: inline-block; width: 14px; height: 14px;
      border: 2px solid rgba(255,255,255,0.4); border-top-color: #fff;
      border-radius: 50%; animation: spin 0.7s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ── CLIENT IMAGES MODAL ── */
    .client-img-row {
      display: flex; align-items: center; gap: 10px;
      padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius);
      background: var(--white); margin-bottom: 6px; cursor: default;
    }
    .client-img-row.dragging { opacity: 0.4; }
    .client-img-row.drag-over { border: 2px dashed var(--red); background: #fff5f5; }
    .client-img-row .ci-handle { color: var(--muted); cursor: grab; font-size: 14px; user-select: none; }
    .client-img-row .ci-thumb {
      width: 48px; height: 48px; border-radius: 6px; object-fit: cover;
      border: 1px solid var(--border); flex-shrink: 0; background: var(--bg);
    }
    .client-img-row .ci-name { flex: 1; font-size: 12px; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .client-img-row .ci-del {
      background: none; border: none; cursor: pointer; color: var(--muted);
      font-size: 16px; padding: 4px; border-radius: 4px; line-height: 1;
    }
    .client-img-row .ci-del:hover { color: #ef4444; background: #fef2f2; }
  </style>
</head>
<body>
<div class="app">

  <!-- HEADER -->
  <header>
    <div class="logo">Art<span>Ecuador</span> <span style="font-size:12px;font-weight:400;color:var(--muted);margin-left:4px;">Admin</span></div>
    <div class="spacer"></div>
    <div class="save-status" id="saveStatus">
      <span class="dot" id="statusDot"></span>
      <span id="statusText">Guardado</span>
    </div>
    <button id="btnSave" disabled>Guardar cambios</button>
    <a href="/" class="btn-back">← Volver al sitio</a>
  </header>

  <div class="body">
    <!-- SIDEBAR -->
    <aside>
      <div class="sidebar-top">
        <div class="stats-box">
          <h4>Estadísticas</h4>
          <div class="stats-row">
            <div class="stat-pill">
              <span class="n" id="statTotal">0</span>
              <span class="l">Total</span>
            </div>
            <div class="stat-pill active">
              <span class="n" id="statActive">0</span>
              <span class="l">Activos</span>
            </div>
            <div class="stat-pill inactive">
              <span class="n" id="statInactive">0</span>
              <span class="l">Inactivos</span>
            </div>
          </div>
        </div>
        <div class="section-label-header">Colecciones</div>
        <ul class="section-list" id="sectionList"></ul>
      </div>
      <div class="sidebar-bottom">
        <button class="btn-add-section" id="btnManageClients" style="margin-bottom:8px;">
          <span style="font-size:15px;line-height:1;">🖼</span> <span id="btnManageClientsLabel">Fotos del mosaico</span>
        </button>
        <button class="btn-add-section" id="btnAddSection">
          <span style="font-size:16px;line-height:1;">+</span> Nueva colección
        </button>
      </div>
    </aside>

    <!-- MAIN -->
    <main>
      <div class="main-header" id="mainHeader">
        <div>
          <div class="section-label-badge" id="mainLabel"></div>
          <h2 id="mainTitle" style="margin-top:4px;"></h2>
        </div>
        <div class="spacer"></div>
        <button class="btn-primary" id="btnAddProduct">
          <span style="font-size:16px;line-height:1;">+</span> Agregar producto
        </button>
      </div>
      <div class="product-list" id="productList"></div>
    </main>
  </div>
</div>

<!-- PRODUCT MODAL -->
<div class="modal-overlay hidden" id="productModal">
  <div class="modal-box">
    <div class="modal-header">
      <h3 id="productModalTitle">Editar producto</h3>
      <button class="modal-close" id="btnCloseProductModal" aria-label="Cerrar">&times;</button>
    </div>
    <div class="modal-body">
      <div class="img-preview-wrap" id="imgPreviewWrap">
        <img class="img-preview hidden" id="imgPreview" alt="Preview" />
        <div class="img-preview-placeholder" id="imgPlaceholder">&#128247;</div>
      </div>
      <div class="form-grid">
        <div class="form-group form-full" id="fgName">
          <label for="fName">Nombre *</label>
          <input type="text" id="fName" placeholder="Nombre del producto" />
          <span class="error-msg hidden" id="errName">El nombre es requerido</span>
        </div>
        <!-- Slug oculto: se genera automáticamente -->
        <input type="hidden" id="fSlug" />
        <div class="form-group">
          <label for="fCategory">Tipo de artesanía</label>
          <input type="text" id="fCategory" placeholder="Ej: Cuadros · Quito" />
        </div>
        <div class="form-group" id="fgPrice">
          <label for="fPrice">Precio</label>
          <div class="price-wrap">
            <span class="prefix">$</span>
            <input type="number" id="fPrice" placeholder="0.00" min="0" step="0.01" />
          </div>
          <span class="error-msg hidden" id="errPrice">Ingresa un precio válido</span>
        </div>
        <div class="form-group form-full">
          <label for="fDesc">Descripción</label>
          <textarea id="fDesc" rows="3" placeholder="Descripción del producto..."></textarea>
        </div>
        <div class="form-group form-full" id="fgImg">
          <label>Foto del producto</label>
          <div class="img-picker-trigger" id="imgPickerTrigger" role="button" tabindex="0">
            <div class="img-picker-thumb" id="imgPickerThumb"><span>📷</span></div>
            <span id="imgPickerName">Seleccionar foto...</span>
          </div>
          <input type="hidden" id="fImg" />
        </div>
        <div class="form-group form-full">
          <label for="fAlt">Descripción de la imagen</label>
          <input type="text" id="fAlt" placeholder="Ej: Cuadro de Guayasamín pintado a mano" />
        </div>
        <div class="form-group">
          <label for="fBadge">Etiqueta especial</label>
          <select id="fBadge">
            <option value="">Sin etiqueta</option>
            <option value="feat">Destacado</option>
            <option value="new">Nuevo</option>
            <option value="limit">Limitado</option>
          </select>
        </div>
        <div class="form-group">
          <label for="fSection">Colección</label>
          <select id="fSection"></select>
        </div>
        <div class="form-group form-full">
          <div class="toggle-row">
            <label class="toggle" for="fActive">
              <input type="checkbox" id="fActive" checked />
              <span class="toggle-slider"></span>
            </label>
            <label class="toggle-label" for="fActive">Activo (visible en el sitio)</label>
          </div>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-secondary" id="btnCancelProduct">Cancelar</button>
      <button class="btn-primary" id="btnSaveProduct">Guardar producto</button>
    </div>
  </div>
</div>

<!-- SECTION MODAL -->
<div class="modal-overlay hidden" id="sectionModal">
  <div class="modal-box small">
    <div class="modal-header">
      <h3 id="sectionModalTitle">Editar sección</h3>
      <button class="modal-close" id="btnCloseSectionModal" aria-label="Cerrar">&times;</button>
    </div>
    <div class="modal-body">
      <div id="delSecConfirmBox" class="del-sec-confirm" style="display:none;">
        <p id="delSecConfirmText">¿Eliminar esta colección?</p>
        <div class="actions">
          <button class="btn-confirm-del" id="btnConfirmDelSection">Sí, eliminar</button>
          <button class="btn-cancel-del" id="btnCancelDelSection">Cancelar</button>
        </div>
      </div>
      <div class="form-grid">
        <div class="form-group" id="fgSTitle">
          <label for="fsTitle">Título principal *</label>
          <input type="text" id="fsTitle" placeholder="Ej: Cuadros" />
          <span class="error-msg hidden" id="errSTitle">Requerido</span>
        </div>
        <div class="form-group">
          <label for="fsTitleEm">Subtítulo</label>
          <input type="text" id="fsTitleEm" placeholder="Ej: y Pinturas" />
        </div>
        <!-- ID oculto: se genera desde el título -->
        <input type="hidden" id="fsId" />
        <div class="form-group form-full">
          <label for="fsLabel">Subtítulo de colección</label>
          <input type="text" id="fsLabel" placeholder="Ej: 01 — Colección" />
        </div>
        <div class="form-group form-full">
          <div class="toggle-row">
            <label class="toggle" for="fsAlt">
              <input type="checkbox" id="fsAlt" />
              <span class="toggle-slider"></span>
            </label>
            <label class="toggle-label" for="fsAlt">Fondo gris suave</label>
          </div>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-danger" id="btnDeleteSection" style="display:none;">Eliminar colección</button>
      <div style="flex:1;"></div>
      <button class="btn-secondary" id="btnCancelSection">Cancelar</button>
      <button class="btn-primary" id="btnSaveSection">Guardar</button>
    </div>
  </div>
</div>

<!-- IMAGE GALLERY MODAL -->
<div class="img-gallery-modal hidden" id="imgGalleryModal">
  <div class="img-gallery-box">
    <div class="img-gallery-header">
      <h4 id="imgGalleryTitle">Seleccionar foto</h4>
      <input class="img-gallery-search" id="imgGallerySearch" type="text" placeholder="Buscar por nombre..." />
      <button class="modal-close" id="btnCloseGallery" aria-label="Cerrar">&times;</button>
    </div>
    <div class="img-gallery-grid" id="imgGalleryGrid"></div>
    <div class="img-gallery-footer">
      <button class="btn-secondary" id="btnUploadImg" style="display:flex;align-items:center;gap:6px;">
        📱 Subir foto
      </button>
      <input type="file" id="fileUploadInput" accept="image/*" style="display:none;" />
      <div style="flex:1;"></div>
      <button class="btn-secondary" id="btnCancelGallery">Cancelar</button>
      <button class="btn-primary" id="btnConfirmGallery">Usar esta foto</button>
    </div>
  </div>
</div>

<!-- CLIENT IMAGES MODAL -->
<div class="modal-overlay hidden" id="clientImagesModal">
  <div class="modal-box" style="max-width:560px;">
    <div class="modal-header">
      <h3>Mosaico — Fotos de clientes</h3>
      <button class="modal-close" id="btnCloseClientsModal" aria-label="Cerrar">&times;</button>
    </div>
    <div class="modal-body">
      <p style="font-size:13px;color:var(--muted);margin-bottom:14px;">
        El mosaico muestra hasta 9 fotos en el orden que aparecen aquí. Arrastra para reordenarlas.
      </p>
      <div id="clientImgList"></div>
      <button class="btn-secondary" id="btnAddClientImg" style="width:100%;margin-top:8px;justify-content:center;display:flex;align-items:center;gap:6px;">
        <span style="font-size:16px;line-height:1;">+</span> Agregar foto al mosaico
      </button>
    </div>
    <div class="modal-footer">
      <button class="btn-secondary" id="btnCancelClients">Cancelar</button>
      <button class="btn-primary" id="btnSaveClients">Guardar mosaico</button>
    </div>
  </div>
</div>

<!-- TOAST -->
<div class="toast hidden" id="toast"></div>

<script>
// ── STATE ──────────────────────────────────────────────────────────────────
let state = { sections: [], clientImages: [] };
let availableImages = { products: [], clients: [] };
let dirty = false;
let activeSectionIdx = 0;
let editingProduct = null;
let editingSection = null;
let dragSrc = null;

// gallery state
let galleryMode = 'products'; // 'products' | 'clients'
let gallerySelectedImg = null;
let galleryOnConfirm = null;

// client images draft (local copy while modal is open)
let clientImagesDraft = [];
let ciDragSrc = null;

// ── UTILS ──────────────────────────────────────────────────────────────────
function toKebab(str) {
  return str.toLowerCase()
    .normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

function badgeLabel(badge) {
  return { feat: 'Destacado', new: 'Nuevo', limit: 'Limitado' }[badge] || '';
}

function esc(str) {
  return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ── DIRTY ─────────────────────────────────────────────────────────────────
function markDirty() { dirty = true; updateSaveStatus(); }
function markClean() { dirty = false; updateSaveStatus(); }
function updateSaveStatus() {
  const dot = document.getElementById('statusDot');
  const txt = document.getElementById('statusText');
  const btn = document.getElementById('btnSave');
  if (dirty) {
    dot.classList.add('dirty');
    txt.textContent = 'Sin guardar';
    btn.disabled = false;
  } else {
    dot.classList.remove('dirty');
    txt.textContent = 'Guardado';
    btn.disabled = true;
  }
}

// ── DATA I/O ──────────────────────────────────────────────────────────────
async function loadData() {
  try {
    const [prodRes, imgRes] = await Promise.all([
      fetch('/api/products'),
      fetch('/api/images'),
    ]);
    if (!prodRes.ok) throw new Error('HTTP ' + prodRes.status);
    state = await prodRes.json();
    if (imgRes.ok) availableImages = await imgRes.json();
    activeSectionIdx = 0;
    markClean();
    render();
    updateClientsBtn();
  } catch (e) {
    showToast('Error al cargar datos: ' + e.message);
  }
}

async function saveData() {
  const btn = document.getElementById('btnSave');
  btn.disabled = true;
  btn.textContent = 'Guardando…';
  const token = sessionStorage.getItem('adminToken') || '';
  try {
    const res = await fetch('/api/products', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
      body: JSON.stringify(state, null, 2),
    });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    markClean();
    showToast('✓ Guardado correctamente');
  } catch (e) {
    showToast('Error al guardar: ' + e.message);
    btn.disabled = false;
  }
  btn.textContent = 'Guardar cambios';
}

// ── TOAST ─────────────────────────────────────────────────────────────────
let toastTimer = null;
function showToast(msg) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.remove('hidden');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.add('hidden'), 2500);
}

// ── STATS ─────────────────────────────────────────────────────────────────
function calcStats() {
  let total = 0, active = 0;
  state.sections.forEach(s => s.products.forEach(p => {
    total++;
    if (p.active !== false) active++;
  }));
  return { total, active, inactive: total - active };
}

function updateClientsBtn() {
  const n = (state.clientImages || []).length;
  document.getElementById('btnManageClientsLabel').textContent = `Fotos del mosaico (${n})`;
}

// ── RENDER ────────────────────────────────────────────────────────────────
function render() { renderSidebar(); renderMain(activeSectionIdx); }

function renderSidebar() {
  const stats = calcStats();
  document.getElementById('statTotal').textContent    = stats.total;
  document.getElementById('statActive').textContent   = stats.active;
  document.getElementById('statInactive').textContent = stats.inactive;

  const ul = document.getElementById('sectionList');
  ul.innerHTML = '';
  state.sections.forEach((sec, idx) => {
    const li = document.createElement('li');
    li.className = idx === activeSectionIdx ? 'active' : '';
    li.draggable = true;
    li.dataset.idx = idx;
    li.innerHTML = `
      <span class="sec-drag-handle" title="Arrastrar para reordenar">⠿</span>
      <span class="sec-name">${esc(sec.title)} <em style="opacity:.65;font-style:normal;">${esc(sec.titleEm)}</em></span>
      <span class="count-badge">${sec.products.length}</span>
      <button class="edit-sec-btn" data-idx="${idx}" title="Editar colección">&#9998;</button>
    `;
    li.addEventListener('click', (e) => {
      if (e.target.closest('.edit-sec-btn') || e.target.closest('.sec-drag-handle')) return;
      activeSectionIdx = idx;
      render();
    });
    li.querySelector('.edit-sec-btn').addEventListener('click', (e) => {
      e.stopPropagation();
      openSectionModal(idx);
    });
    ul.appendChild(li);
  });

  setupSectionDragDrop(ul);
}

function renderMain(sectionIdx) {
  const sec = state.sections[sectionIdx];
  if (!sec) {
    document.getElementById('mainLabel').textContent = '';
    document.getElementById('mainTitle').innerHTML   = '';
    document.getElementById('productList').innerHTML = '<div class="product-grid"><div class="empty-state"><div class="icon">📂</div><p>No hay colecciones. Crea una.</p></div></div>';
    return;
  }

  document.getElementById('mainLabel').textContent = sec.label || '';
  document.getElementById('mainTitle').innerHTML   = `${esc(sec.title)} <em>${esc(sec.titleEm)}</em>`;

  const listEl = document.getElementById('productList');
  listEl.innerHTML = '';

  const grid = document.createElement('div');
  grid.className = 'product-grid';

  if (sec.products.length === 0) {
    grid.innerHTML = '<div class="empty-state"><div class="icon">🛍️</div><p>Esta colección no tiene productos. Agrega uno.</p></div>';
    listEl.appendChild(grid);
    return;
  }

  sec.products.forEach((p, pIdx) => {
    const card = buildProductCard(p, sectionIdx, pIdx);
    grid.appendChild(card);
  });

  listEl.appendChild(grid);
  setupDragDrop(grid, sectionIdx);
}

function buildProductCard(p, sectionIdx, pIdx) {
  const card = document.createElement('div');
  const isActive = p.active !== false;
  card.className = 'product-card-admin' + (isActive ? '' : ' inactive-card');
  card.dataset.sectionIdx = sectionIdx;
  card.dataset.productIdx = pIdx;
  card.draggable = true;

  const badgeHtml = p.badge
    ? `<span class="badge-chip ${p.badge}">${badgeLabel(p.badge)}</span>`
    : '';
  const priceHtml = p.price
    ? `<div class="card-price">$${esc(p.price)}</div>`
    : `<div class="card-no-price">Sin precio</div>`;

  card.innerHTML = `
    <div class="card-topbar">
      <span class="drag-handle" title="Arrastrar para reordenar">⠿</span>
      ${badgeHtml}
      <div class="card-topbar-spacer"></div>
      <label class="toggle" title="${isActive ? 'Visible' : 'Oculto'}">
        <input type="checkbox" ${isActive ? 'checked' : ''} class="active-toggle" />
        <span class="toggle-slider"></span>
      </label>
      <button class="icon-btn edit-btn" title="Editar producto">✏️</button>
      <button class="icon-btn delete delete-btn" title="Eliminar">🗑</button>
    </div>
    <div class="card-img-wrap img-click-edit">
      <div class="card-img-edit-hint">✏️ Editar</div>
      ${p.img
        ? `<img src="/media/products/${encodeURIComponent(p.img)}" alt="${esc(p.alt || p.name)}" loading="lazy" />`
        : `<div class="card-img-placeholder">📷</div>`}
    </div>
    <div class="card-body">
      <div class="card-name">${esc(p.name)}</div>
      ${p.category ? `<div class="card-cat">${esc(p.category)}</div>` : ''}
      ${priceHtml}
    </div>
  `;

  card.querySelector('.active-toggle').addEventListener('change', function() {
    state.sections[sectionIdx].products[pIdx].active = this.checked;
    card.classList.toggle('inactive-card', !this.checked);
    markDirty();
    renderSidebar();
  });
  card.querySelector('.edit-btn').addEventListener('click', (e) => {
    e.stopPropagation();
    openProductModal(sectionIdx, pIdx);
  });
  card.querySelector('.delete-btn').addEventListener('click', (e) => {
    e.stopPropagation();
    showDeleteConfirm(card, sectionIdx, pIdx);
  });
  card.querySelector('.img-click-edit').addEventListener('click', () => {
    openProductModal(sectionIdx, pIdx);
  });

  return card;
}

function showDeleteConfirm(card, sIdx, pIdx) {
  const p = state.sections[sIdx].products[pIdx];
  const confirmEl = document.createElement('div');
  confirmEl.className = 'confirm-card';
  confirmEl.innerHTML = `
    <div class="confirm-text">¿Eliminar <strong>${esc(p.name)}</strong>?</div>
    <div class="confirm-actions">
      <button class="btn-confirm-del">Sí, eliminar</button>
      <button class="btn-cancel-del">Cancelar</button>
    </div>
  `;
  confirmEl.querySelector('.btn-confirm-del').addEventListener('click', () => {
    state.sections[sIdx].products.splice(pIdx, 1);
    markDirty();
    render();
  });
  confirmEl.querySelector('.btn-cancel-del').addEventListener('click', () => {
    confirmEl.replaceWith(card);
  });
  card.replaceWith(confirmEl);
}

// ── PRODUCT DRAG & DROP ───────────────────────────────────────────────────
function setupDragDrop(gridEl, sectionIdx) {
  gridEl.querySelectorAll('.product-card-admin').forEach((card) => {
    card.addEventListener('dragstart', (e) => {
      dragSrc = +card.dataset.productIdx;
      card.classList.add('dragging');
      e.dataTransfer.effectAllowed = 'move';
    });
    card.addEventListener('dragend', () => {
      card.classList.remove('dragging');
      gridEl.querySelectorAll('.product-card-admin').forEach(c => c.classList.remove('drag-over'));
    });
    card.addEventListener('dragover', (e) => {
      e.preventDefault();
      gridEl.querySelectorAll('.product-card-admin').forEach(c => c.classList.remove('drag-over'));
      card.classList.add('drag-over');
    });
    card.addEventListener('dragleave', () => card.classList.remove('drag-over'));
    card.addEventListener('drop', (e) => {
      e.preventDefault();
      const destIdx = +card.dataset.productIdx;
      if (dragSrc === null || dragSrc === destIdx) return;
      const prods = state.sections[sectionIdx].products;
      const [moved] = prods.splice(dragSrc, 1);
      prods.splice(destIdx, 0, moved);
      markDirty();
      renderMain(sectionIdx);
    });
  });
}

// ── SECTION DRAG & DROP ───────────────────────────────────────────────────
let secDragSrc = null;
function setupSectionDragDrop(ul) {
  ul.querySelectorAll('li').forEach((li) => {
    li.addEventListener('dragstart', (e) => {
      secDragSrc = +li.dataset.idx;
      e.dataTransfer.effectAllowed = 'move';
    });
    li.addEventListener('dragend', () => {
      ul.querySelectorAll('li').forEach(l => l.classList.remove('sec-drag-over'));
    });
    li.addEventListener('dragover', (e) => {
      e.preventDefault();
      ul.querySelectorAll('li').forEach(l => l.classList.remove('sec-drag-over'));
      li.classList.add('sec-drag-over');
    });
    li.addEventListener('dragleave', () => li.classList.remove('sec-drag-over'));
    li.addEventListener('drop', (e) => {
      e.preventDefault();
      const destIdx = +li.dataset.idx;
      if (secDragSrc === null || secDragSrc === destIdx) return;
      const currentSection = state.sections[activeSectionIdx];
      const [moved] = state.sections.splice(secDragSrc, 1);
      state.sections.splice(destIdx, 0, moved);
      activeSectionIdx = state.sections.indexOf(currentSection);
      markDirty();
      render();
    });
  });
}

// ── PRODUCT MODAL ─────────────────────────────────────────────────────────
function openProductModal(sectionIdx, productIdx) {
  editingProduct = { sectionIdx, productIdx };
  const isNew = productIdx === -1;
  const p = isNew ? { active: true } : state.sections[sectionIdx].products[productIdx];

  document.getElementById('productModalTitle').textContent = isNew ? 'Agregar producto' : 'Editar producto';

  const fSection = document.getElementById('fSection');
  fSection.innerHTML = '';
  state.sections.forEach((s, i) => {
    const opt = document.createElement('option');
    opt.value = i;
    opt.textContent = `${s.title} ${s.titleEm}`;
    if (i === sectionIdx) opt.selected = true;
    fSection.appendChild(opt);
  });

  document.getElementById('fName').value     = p.name     || '';
  document.getElementById('fSlug').value     = p.slug     || '';
  document.getElementById('fCategory').value = p.category || '';
  document.getElementById('fPrice').value    = p.price    || '';
  document.getElementById('fDesc').value     = p.desc     || '';
  document.getElementById('fImg').value      = p.img      || '';
  document.getElementById('fAlt').value      = p.alt      || '';
  document.getElementById('fBadge').value    = p.badge    || '';
  document.getElementById('fActive').checked = p.active !== false;

  document.getElementById('fgName').classList.remove('has-error');
  document.getElementById('errName').classList.add('hidden');
  document.getElementById('fgPrice').classList.remove('has-error');
  document.getElementById('errPrice').classList.add('hidden');

  setImgPickerValue(p.img || '', 'products');
  updateImgPreview(p.img || '');
  document.getElementById('productModal').classList.remove('hidden');
  document.getElementById('fName').focus();
}

function setImgPickerValue(filename, mode) {
  const thumb = document.getElementById('imgPickerThumb');
  const name  = document.getElementById('imgPickerName');
  const prefix = mode === 'clients' ? '/media/clients/' : '/media/products/';
  if (filename) {
    thumb.innerHTML = `<img src="${prefix}${encodeURIComponent(filename)}" alt="" />`;
    name.textContent = filename;
  } else {
    thumb.innerHTML = '<span>📷</span>';
    name.textContent = 'Seleccionar foto...';
  }
}

function updateImgPreview(filename) {
  const img = document.getElementById('imgPreview');
  const ph  = document.getElementById('imgPlaceholder');
  if (!filename) { img.classList.add('hidden'); ph.classList.remove('hidden'); return; }
  img.src = '/media/products/' + encodeURIComponent(filename);
  img.onload  = () => { img.classList.remove('hidden'); ph.classList.add('hidden'); };
  img.onerror = () => { img.classList.add('hidden'); ph.classList.remove('hidden'); };
}

function closeProductModal() {
  document.getElementById('productModal').classList.add('hidden');
  editingProduct = null;
}

function saveProductModal() {
  const name = document.getElementById('fName').value.trim();
  let valid = true;

  if (!name) {
    document.getElementById('fgName').classList.add('has-error');
    document.getElementById('errName').classList.remove('hidden');
    valid = false;
  } else {
    document.getElementById('fgName').classList.remove('has-error');
    document.getElementById('errName').classList.add('hidden');
  }

  const rawPrice = document.getElementById('fPrice').value.trim();
  let priceStr = '';
  if (rawPrice) {
    const parsed = parseFloat(rawPrice);
    if (isNaN(parsed) || parsed < 0) {
      document.getElementById('fgPrice').classList.add('has-error');
      document.getElementById('errPrice').classList.remove('hidden');
      valid = false;
    } else {
      document.getElementById('fgPrice').classList.remove('has-error');
      document.getElementById('errPrice').classList.add('hidden');
      priceStr = parsed.toFixed(2);
    }
  }

  if (!valid) return;

  const { sectionIdx, productIdx } = editingProduct;
  const isNew = productIdx === -1;
  const existingSlug = isNew ? '' : (state.sections[sectionIdx].products[productIdx].slug || '');
  const slug = existingSlug || toKebab(name);

  const targetSectionIdx = +document.getElementById('fSection').value;
  const product = {
    slug,
    img:      document.getElementById('fImg').value.trim(),
    alt:      document.getElementById('fAlt').value.trim(),
    badge:    document.getElementById('fBadge').value || undefined,
    category: document.getElementById('fCategory').value.trim(),
    name,
    desc:     document.getElementById('fDesc').value.trim(),
    price:    priceStr,
    active:   document.getElementById('fActive').checked,
  };
  if (!product.badge) delete product.badge;

  if (isNew) {
    state.sections[targetSectionIdx].products.push(product);
  } else if (targetSectionIdx !== sectionIdx) {
    state.sections[sectionIdx].products.splice(productIdx, 1);
    state.sections[targetSectionIdx].products.push(product);
    activeSectionIdx = targetSectionIdx;
  } else {
    state.sections[sectionIdx].products[productIdx] = product;
  }

  markDirty();
  closeProductModal();
  render();
}

// ── SECTION MODAL ─────────────────────────────────────────────────────────
function openSectionModal(sectionIdx) {
  editingSection = sectionIdx;
  const isNew = sectionIdx === -1;
  const s = isNew ? {} : state.sections[sectionIdx];

  document.getElementById('sectionModalTitle').textContent = isNew ? 'Nueva colección' : 'Editar colección';
  document.getElementById('fsTitle').value   = s.title   || '';
  document.getElementById('fsTitleEm').value = s.titleEm || '';
  document.getElementById('fsId').value      = s.id      || '';
  document.getElementById('fsLabel').value   = s.label   || '';
  document.getElementById('fsAlt').checked   = s.alt     || false;

  document.getElementById('fgSTitle').classList.remove('has-error');
  document.getElementById('errSTitle').classList.add('hidden');

  document.getElementById('delSecConfirmBox').style.display = 'none';
  document.getElementById('btnDeleteSection').style.display = isNew ? 'none' : '';

  document.getElementById('sectionModal').classList.remove('hidden');
  document.getElementById('fsTitle').focus();
}

function closeSectionModal() {
  document.getElementById('sectionModal').classList.add('hidden');
  editingSection = null;
}

function saveSectionModal() {
  const title = document.getElementById('fsTitle').value.trim();
  let valid = true;

  if (!title) {
    document.getElementById('fgSTitle').classList.add('has-error');
    document.getElementById('errSTitle').classList.remove('hidden');
    valid = false;
  } else {
    document.getElementById('fgSTitle').classList.remove('has-error');
    document.getElementById('errSTitle').classList.add('hidden');
  }
  if (!valid) return;

  const existingId = editingSection === -1 ? '' : (state.sections[editingSection].id || '');
  const id = existingId || toKebab(title);

  const section = {
    id,
    label:   document.getElementById('fsLabel').value.trim(),
    title,
    titleEm: document.getElementById('fsTitleEm').value.trim(),
    alt:     document.getElementById('fsAlt').checked,
    products: editingSection === -1 ? [] : state.sections[editingSection].products,
  };

  if (editingSection === -1) {
    state.sections.push(section);
    activeSectionIdx = state.sections.length - 1;
  } else {
    state.sections[editingSection] = section;
  }

  markDirty();
  closeSectionModal();
  render();
}

function deleteSection() {
  const sec = state.sections[editingSection];
  const count = sec.products.length;
  const box = document.getElementById('delSecConfirmBox');

  if (box.style.display !== 'none') return; // ya visible — clic doble

  document.getElementById('delSecConfirmText').textContent =
    count > 0
      ? `Esta colección tiene ${count} producto${count !== 1 ? 's' : ''}. ¿Eliminarla con todo su contenido?`
      : '¿Eliminar esta colección?';
  box.style.display = '';
}

// ── IMAGE GALLERY ─────────────────────────────────────────────────────────
function openGallery(mode, currentImg, onConfirm) {
  galleryMode = mode;
  gallerySelectedImg = currentImg || null;
  galleryOnConfirm = onConfirm;

  document.getElementById('imgGalleryTitle').textContent =
    mode === 'clients' ? 'Seleccionar foto del mosaico' : 'Seleccionar foto del producto';
  document.getElementById('imgGallerySearch').value = '';
  renderGalleryGrid('');
  document.getElementById('imgGalleryModal').classList.remove('hidden');
  document.getElementById('imgGallerySearch').focus();
}

function renderGalleryGrid(filter) {
  const imgs = availableImages[galleryMode] || [];
  const grid = document.getElementById('imgGalleryGrid');
  grid.innerHTML = '';

  const filtered = filter ? imgs.filter(f => f.toLowerCase().includes(filter.toLowerCase())) : imgs;

  if (filtered.length === 0) {
    grid.innerHTML = `<div class="img-gallery-empty">No se encontraron imágenes${filter ? ' para "' + esc(filter) + '"' : ''}.</div>`;
    return;
  }

  const prefix = galleryMode === 'clients' ? '/media/clients/' : '/media/products/';
  filtered.forEach(filename => {
    const item = document.createElement('div');
    item.className = 'img-gallery-item' + (filename === gallerySelectedImg ? ' selected' : '');
    item.dataset.filename = filename;
    item.innerHTML = `
      <img src="${prefix}${encodeURIComponent(filename)}" alt="${esc(filename)}" loading="lazy" />
      <span class="img-label">${esc(filename)}</span>
    `;
    item.addEventListener('click', () => {
      grid.querySelectorAll('.img-gallery-item').forEach(el => el.classList.remove('selected'));
      item.classList.add('selected');
      gallerySelectedImg = filename;
    });
    grid.appendChild(item);
  });
}

function closeGallery() {
  document.getElementById('imgGalleryModal').classList.add('hidden');
  galleryOnConfirm = null;
}

function confirmGallery() {
  if (!gallerySelectedImg) { showToast('Selecciona una foto primero'); return; }
  if (galleryOnConfirm) galleryOnConfirm(gallerySelectedImg);
  closeGallery();
}

// ── CLIENT IMAGES MODAL ───────────────────────────────────────────────────
function openClientsModal() {
  clientImagesDraft = [...(state.clientImages || [])];
  renderClientImgList();
  document.getElementById('clientImagesModal').classList.remove('hidden');
}

function closeClientsModal() {
  document.getElementById('clientImagesModal').classList.add('hidden');
}

function saveClientsModal() {
  state.clientImages = [...clientImagesDraft];
  markDirty();
  updateClientsBtn();
  closeClientsModal();
  showToast('✓ Mosaico actualizado');
}

function renderClientImgList() {
  const list = document.getElementById('clientImgList');
  list.innerHTML = '';

  if (clientImagesDraft.length === 0) {
    list.innerHTML = '<p style="font-size:13px;color:var(--muted);text-align:center;padding:20px 0;">No hay fotos en el mosaico.</p>';
    return;
  }

  clientImagesDraft.forEach((filename, idx) => {
    const row = document.createElement('div');
    row.className = 'client-img-row';
    row.draggable = true;
    row.dataset.idx = idx;
    row.innerHTML = `
      <span class="ci-handle" title="Arrastrar">⠿</span>
      <img class="ci-thumb" src="/media/clients/${encodeURIComponent(filename)}" alt="${esc(filename)}" />
      <span class="ci-name">${esc(filename)}</span>
      <button class="ci-del" data-idx="${idx}" title="Quitar del mosaico">&times;</button>
    `;
    row.querySelector('.ci-del').addEventListener('click', function() {
      clientImagesDraft.splice(+this.dataset.idx, 1);
      renderClientImgList();
    });
    // drag & drop
    row.addEventListener('dragstart', () => { ciDragSrc = idx; row.classList.add('dragging'); });
    row.addEventListener('dragend', () => {
      row.classList.remove('dragging');
      list.querySelectorAll('.client-img-row').forEach(r => r.classList.remove('drag-over'));
    });
    row.addEventListener('dragover', (e) => {
      e.preventDefault();
      list.querySelectorAll('.client-img-row').forEach(r => r.classList.remove('drag-over'));
      row.classList.add('drag-over');
    });
    row.addEventListener('dragleave', () => row.classList.remove('drag-over'));
    row.addEventListener('drop', (e) => {
      e.preventDefault();
      const dest = +row.dataset.idx;
      if (ciDragSrc === null || ciDragSrc === dest) return;
      const [moved] = clientImagesDraft.splice(ciDragSrc, 1);
      clientImagesDraft.splice(dest, 0, moved);
      renderClientImgList();
    });
    list.appendChild(row);
  });
}

// ── UPLOAD ────────────────────────────────────────────────────────────────
async function uploadFile(file) {
  const token = sessionStorage.getItem('adminToken') || '';
  const btn = document.getElementById('btnUploadImg');
  const original = btn.innerHTML;
  btn.innerHTML = '<span class="upload-spinner"></span> Subiendo...';
  btn.disabled = true;

  try {
    const fd = new FormData();
    fd.append('file', file);
    fd.append('folder', galleryMode);
    const res = await fetch('/api/upload', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + token },
      body: fd,
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Error al subir');

    // Refresh image list and select the new file
    const imgRes = await fetch('/api/images');
    if (imgRes.ok) availableImages = await imgRes.json();

    gallerySelectedImg = data.filename;
    const search = document.getElementById('imgGallerySearch').value.trim();
    renderGalleryGrid(search);
    showToast('✓ Foto subida: ' + data.filename);
  } catch (e) {
    showToast('Error: ' + e.message);
  } finally {
    btn.innerHTML = original;
    btn.disabled = false;
  }
}

// ── EVENT LISTENERS ───────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  if (!sessionStorage.getItem('adminToken')) {
    window.location.replace('/');
    return;
  }
  loadData();

  // header / global
  document.getElementById('btnSave').addEventListener('click', saveData);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (!document.getElementById('imgGalleryModal').classList.contains('hidden')) { closeGallery(); return; }
      if (!document.getElementById('clientImagesModal').classList.contains('hidden')) { closeClientsModal(); return; }
      if (!document.getElementById('productModal').classList.contains('hidden')) { closeProductModal(); return; }
      if (!document.getElementById('sectionModal').classList.contains('hidden'))  { closeSectionModal(); return; }
    }
    if ((e.ctrlKey || e.metaKey) && e.key === 's') { e.preventDefault(); if (dirty) saveData(); }
  });

  // product modal
  document.getElementById('btnAddProduct').addEventListener('click', () => {
    if (state.sections.length === 0) { showToast('Crea una colección primero'); return; }
    openProductModal(activeSectionIdx, -1);
  });
  document.getElementById('btnCloseProductModal').addEventListener('click', closeProductModal);
  document.getElementById('btnCancelProduct').addEventListener('click', closeProductModal);
  document.getElementById('btnSaveProduct').addEventListener('click', saveProductModal);
  document.getElementById('productModal').addEventListener('click', (e) => {
    if (e.target === e.currentTarget) closeProductModal();
  });

  // image picker trigger
  document.getElementById('imgPickerTrigger').addEventListener('click', () => {
    const current = document.getElementById('fImg').value;
    openGallery('products', current, (filename) => {
      document.getElementById('fImg').value = filename;
      setImgPickerValue(filename, 'products');
      updateImgPreview(filename);
    });
  });
  document.getElementById('imgPickerTrigger').addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') e.currentTarget.click();
  });

  // section buttons
  document.getElementById('btnAddSection').addEventListener('click', () => openSectionModal(-1));
  document.getElementById('btnCloseSectionModal').addEventListener('click', closeSectionModal);
  document.getElementById('btnCancelSection').addEventListener('click', closeSectionModal);
  document.getElementById('btnSaveSection').addEventListener('click', saveSectionModal);
  document.getElementById('btnDeleteSection').addEventListener('click', deleteSection);
  document.getElementById('btnConfirmDelSection').addEventListener('click', () => {
    const idx = editingSection;
    state.sections.splice(idx, 1);
    if (activeSectionIdx >= state.sections.length) activeSectionIdx = Math.max(0, state.sections.length - 1);
    markDirty();
    closeSectionModal();
    render();
  });
  document.getElementById('btnCancelDelSection').addEventListener('click', () => {
    document.getElementById('delSecConfirmBox').style.display = 'none';
  });
  document.getElementById('sectionModal').addEventListener('click', (e) => {
    if (e.target === e.currentTarget) closeSectionModal();
  });

  // gallery modal
  document.getElementById('btnCloseGallery').addEventListener('click', closeGallery);
  document.getElementById('btnCancelGallery').addEventListener('click', closeGallery);
  document.getElementById('btnConfirmGallery').addEventListener('click', confirmGallery);
  document.getElementById('imgGallerySearch').addEventListener('input', function() {
    renderGalleryGrid(this.value.trim());
  });
  document.getElementById('btnUploadImg').addEventListener('click', () => {
    document.getElementById('fileUploadInput').click();
  });
  document.getElementById('fileUploadInput').addEventListener('change', function() {
    if (this.files && this.files[0]) {
      uploadFile(this.files[0]);
      this.value = ''; // reset so same file can be uploaded again
    }
  });

  // client images modal
  document.getElementById('btnManageClients').addEventListener('click', openClientsModal);
  document.getElementById('btnCloseClientsModal').addEventListener('click', closeClientsModal);
  document.getElementById('btnCancelClients').addEventListener('click', closeClientsModal);
  document.getElementById('btnSaveClients').addEventListener('click', saveClientsModal);
  document.getElementById('clientImagesModal').addEventListener('click', (e) => {
    if (e.target === e.currentTarget) closeClientsModal();
  });
  document.getElementById('btnAddClientImg').addEventListener('click', () => {
    openGallery('clients', null, (filename) => {
      if (!clientImagesDraft.includes(filename)) {
        clientImagesDraft.push(filename);
        renderClientImgList();
      } else {
        showToast('Esa foto ya está en el mosaico');
      }
    });
  });

  // fName → auto slug for new products (slug field is now hidden)
  document.getElementById('fName').addEventListener('input', function() {
    const slugField = document.getElementById('fSlug');
    if (editingProduct && editingProduct.productIdx === -1) {
      slugField.value = toKebab(this.value);
    }
  });
});
</script>
</body>
</html>
