---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
}
const {
  title       = 'ArtEcuador — Catálogo de Artesanías',
  description = 'Catálogo de artesanías ecuatorianas auténticas, elaboradas a mano por comunidades andinas. Cuadros, cerámica, cuero y más.',
  ogImage     = '/media/logoFinal.png',
  ogType      = 'website',
  canonical,
} = Astro.props;

const siteUrl = 'https://artecuador.com';
const pageUrl = canonical ? `${siteUrl}${canonical}` : siteUrl;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type"        content={ogType} />
    <meta property="og:url"         content={pageUrl} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={`${siteUrl}${ogImage}`} />
    <meta property="og:site_name"   content="ArtEcuador" />
    <meta property="og:locale"      content="es_EC" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={`${siteUrl}${ogImage}`} />

    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/png" href="/media/iconoFinal.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <slot />
    <script>
      // Contador de visitas — registra la visita una vez por carga de página.
      try {
        fetch('/api/track', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ path: location.pathname }),
          keepalive: true,
        }).catch(() => {});
      } catch (_) { /* sin contador no se rompe nada */ }
    </script>
  </body>
</html>
